PAYCREW_WEBHOOK_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,https://your-project.pages.dev
MOCK_CALLS=true
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com
# Selected architecture: Brainbase workflow + connected Link wallet.
# The backend connector is pending. This value disables legacy Stripe calls.
PAYMENT_PROVIDER=brainbase_link
# Optional LEGACY test-transfer adapter only; not required for Brainbase + Link.
# Do not switch to stripe_test or supply keys without separate authorization.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:8000/webhooks/stripe`, or Dashboard.
STRIPE_WEBHOOK_SECRET=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
CALL_PROVIDER=brainbase
CLEAN_VENDOR_PHONE=+1replace-with-zubairs-number
FAST_CONSULT_PHONE=+1replace-with-shresths-number
