PAYCREW_WEBHOOK_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,https://your-project.pages.dev
MOCK_CALLS=true
# Mock call results per vendor (others confirm) and delay before the mock answers
MOCK_CALL_OUTCOMES=CleanVendor Inc=denied
MOCK_CALL_DELAY_SECONDS=5
CALL_TIMEOUT_SECONDS=180
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com
# Selected architecture: Brainbase payer agent + connected Link wallet (see docs/brainbase-link-integration.md).
PAYMENT_PROVIDER=brainbase_link
# Kill switch. Leave false until the payer agent's Link wallet, checkout links and spend limit are agreed.
# When true, a clean upload or an Approve click starts a REAL Link checkout (live money).
BRAINBASE_PAYMENTS_ENABLED=false
# PAT from `brainbase token create --scopes read,publish` (run it yourself; never commit it)
BRAINBASE_TOKEN=
# PayCrew Payer agent (brainbase-agents/payer)
BRAINBASE_PAYER_AGENT_ID=1b4ece5e-a9c4-46ea-8c27-e43f590bb818
# Demo: really charge this many cents (e.g. 100 = $1) per invoice while the board shows the invoice total.
# Price every vendor checkout link at this amount. Leave empty to pay real invoice totals.
BRAINBASE_DEMO_CHARGE_CENTS=
# Hard per-invoice cap in cents; larger invoices escalate to a human instead of paying
BRAINBASE_PAY_MAX_CENTS=
# Trusted checkout page per vendor (JSON). The payer may pay ONLY here, never at a link from an invoice.
VENDOR_PAYMENT_URLS={}
# Seconds to wait for Link approval + checkout before escalating as unknown
BRAINBASE_PAY_TIMEOUT_SECONDS=1800
# Optional LEGACY test-transfer adapter only; not required for Brainbase + Link.
# Do not switch to stripe_test or supply keys without separate authorization.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:8000/webhooks/stripe`, or Dashboard.
STRIPE_WEBHOOK_SECRET=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
CALL_PROVIDER=brainbase
CLEAN_VENDOR_PHONE=+1replace-with-zubairs-number
FAST_CONSULT_PHONE=+1replace-with-shresths-number
